<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     xmlns:tools="http://schemas.android.com/tools"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/screen_bg"
     android:fitsSystemWindows="true"
    android:id="@+id/drawer_layout">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
             android:layout_height="?attr/actionBarSize"
             android:layout_width="match_parent"
             android:background="@color/screen_bg"
             android:id="@+id/toolbar">

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <ImageButton
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:src="@drawable/ic_menu"
                     android:contentDescription="@string/menu_button_description"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     app:tint="@color/text_primary"
                     android:padding="12dp"
                     android:id="@+id/drawer_button" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:clickable="true"
                     android:textSize="20sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginStart="16dp"
                     android:focusable="true"
                     android:foreground="?attr/selectableItemBackground"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:layout_weight="1"
                     android:id="@+id/model_selector"
                     android:text="XL"
                     android:textStyle="normal" />

                <ImageButton
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:src="@drawable/ic_edit"
                     android:contentDescription="@string/edit_button_description"
                     android:layout_marginEnd="8dp"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     app:tint="@color/text_primary"
                     android:padding="12dp"
                     android:id="@+id/edit_button" />

                <ImageButton
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:src="@drawable/ic_more_vert"
                     android:contentDescription="@string/options_button_description"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     app:tint="@color/text_primary"
                     android:padding="12dp"
                     android:id="@+id/options_button" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
             android:layout_height="0dp"
             android:layout_width="match_parent"
             android:background="@color/screen_bg"
             android:layout_weight="1"
             android:id="@+id/content_frame">

            <androidx.recyclerview.widget.RecyclerView
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:padding="8dp"
                 android:clipToPadding="false"
                 android:id="@+id/recyclerView" />

            <LinearLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:visibility="visible"
                 android:gravity="center"
                 android:padding="32dp"
                 android:orientation="vertical"
                 android:id="@+id/welcome_screen">

                <com.xxq.xlai.GradientTextview
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:textSize="24sp"
                     android:textColor="@color/text_primary"
                     android:id="@+id/welcome_main_title_textview"
                     android:text="Introducing Stealth-1"
                     android:textStyle="bold" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:textSize="16sp"
                     android:textColor="@color/text_secondary"
                     android:id="@+id/welcome_title_textview"
                     android:paddingTop="16dp"
                     android:text="Experience Unrestricted Intelligence" />

            </LinearLayout>

            <ProgressBar
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:visibility="gone"
                 android:id="@+id/progressBar"
                 android:layout_gravity="center" />

        </FrameLayout>

        <androidx.cardview.widget.CardView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_margin="8dp"
             app:cardElevation="0dp"
             app:cardBackgroundColor="@android:color/transparent"
             app:cardCornerRadius="28dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:background="@drawable/rounded_eddittext_background"
                 android:paddingVertical="6dp"
                 android:paddingHorizontal="8dp">

                <LinearLayout
                     android:layout_height="34dp"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="4dp"
                     android:visibility="gone"
                     android:paddingEnd="10dp"
                     android:gravity="center_vertical"
                     app:layout_constraintTop_toTopOf="parent"
                     android:orientation="horizontal"
                     app:layout_constraintStart_toStartOf="parent"
                     android:paddingStart="12dp"
                     android:layout_marginStart="4dp"
                     android:id="@+id/edit_message_pill_container">

                    <ImageView
                         android:layout_height="16dp"
                         android:layout_width="16dp"
                         android:src="@drawable/ic_edit"
                         android:layout_marginEnd="6dp"
                         app:tint="@color/edit_pill_text" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textAppearance="@style/SafeTextAppearance"
                         android:textSize="14sp"
                         android:textColor="@color/edit_pill_text"
                         android:text="Edit Message"
                         android:textStyle="bold" />

                    <ImageButton
                         android:layout_height="20dp"
                         android:layout_width="20dp"
                         android:scaleType="centerInside"
                         android:src="@drawable/ic_close"
                         android:contentDescription="Cancel Edit"
                         android:background="?attr/selectableItemBackgroundBorderless"
                         android:padding="2dp"
                         app:tint="@color/edit_pill_text"
                         android:layout_marginStart="8dp"
                         android:id="@+id/cancel_edit_button" />

                </LinearLayout>

                <FrameLayout
                     android:layout_height="84dp"
                     android:layout_width="84dp"
                     android:layout_marginBottom="4dp"
                     android:visibility="gone"
                     app:layout_constraintStart_toStartOf="parent"
                     android:layout_marginTop="8dp"
                     android:layout_marginStart="4dp"
                     app:layout_constraintTop_toBottomOf="@id/edit_message_pill_container"
                     android:id="@+id/image_preview_container">

                    <ImageView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:scaleType="centerCrop"
                         android:background="@drawable/rounded_image_background"
                         android:clipToOutline="true"
                         android:id="@+id/image_preview" />

                    <ImageButton
                         android:layout_height="24dp"
                         android:layout_width="24dp"
                         android:src="@drawable/ic_close"
                         android:background="@drawable/circle_light_grey_background"
                         app:tint="@color/text_primary"
                         android:layout_margin="4dp"
                         android:id="@+id/remove_image_button"
                         android:layout_gravity="top|end" />

                </FrameLayout>

                <ImageButton
                     android:layout_height="38dp"
                     android:layout_width="38dp"
                     android:src="@drawable/ic_attach"
                     android:scaleType="centerInside"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     app:tint="@color/text_primary"
                     android:padding="7dp"
                     app:layout_constraintStart_toStartOf="parent"
                     app:layout_constraintBottom_toBottomOf="parent"
                     android:id="@+id/attach_button" />

                <ImageButton
                     android:layout_height="40dp"
                     android:layout_width="40dp"
                     android:src="@drawable/ic_send_arrow"
                     android:clickable="true"
                     android:padding="9dp"
                     android:enabled="false"
                     app:layout_constraintBottom_toBottomOf="parent"
                     android:focusable="true"
                     android:scaleType="centerInside"
                     android:background="@drawable/circle_background_send_button"
                     app:tint="@color/send_button_icon"
                     app:layout_constraintEnd_toEndOf="parent"
                     android:id="@+id/send_message_button" />

                <EditText
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     app:layout_constraintStart_toEndOf="@id/attach_button"
                     app:layout_constraintEnd_toStartOf="@id/send_message_button"
                     app:layout_constraintBottom_toBottomOf="parent"
                     app:layout_constraintTop_toBottomOf="@id/image_preview_container"
                     android:scrollbars="vertical"
                     android:background="@null"
                     android:gravity="center_vertical|start"
                     android:hint="Ask anything"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:minHeight="40dp"
                     android:paddingVertical="4dp"
                     android:textColorHint="@color/text_secondary"
                     android:paddingHorizontal="8dp"
                     android:maxLines="6"
                     android:id="@+id/inputMessage" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <include
         layout="@layout/nav_drawer"
         android:layout_width="320dp"
         android:layout_height="match_parent"
         android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>