<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="@drawable/rounded_bottom_sheet_background"
     app:cardElevation="0dp"
     app:cardCornerRadius="16dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingBottom="8dp"
         android:paddingTop="8dp">

        <View
             android:layout_height="4dp"
             android:layout_width="40dp"
             android:layout_marginBottom="16dp"
             android:background="@drawable/rounded_handle"
             android:layout_gravity="center_horizontal" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="24dp"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:orientation="vertical"
             android:paddingBottom="16dp"
             android:paddingStart="24dp"
             android:focusable="true"
             android:id="@+id/option_camera_upload"
             android:paddingTop="16dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="@android:color/black"
                 android:text="Camera upload" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="@android:color/darker_gray"
                 android:text="This option will come soon!" />

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="#E0E0E0" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="24dp"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:orientation="vertical"
             android:paddingBottom="16dp"
             android:paddingStart="24dp"
             android:focusable="true"
             android:id="@+id/option_gallery"
             android:paddingTop="16dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="@android:color/black"
                 android:text="Photos and gallery" />

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="#E0E0E0" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="24dp"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:orientation="vertical"
             android:paddingBottom="16dp"
             android:paddingStart="24dp"
             android:focusable="true"
             android:id="@+id/option_web_search"
             android:paddingTop="16dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="@android:color/black"
                 android:text="Web Search" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="@android:color/darker_gray"
                 android:text="Enhance your answer with real-time results" />

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="#E0E0E0" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="24dp"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:orientation="vertical"
             android:paddingBottom="16dp"
             android:paddingStart="24dp"
             android:focusable="true"
             android:id="@+id/option_files"
             android:paddingTop="16dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:fontFamily="sans-serif-medium"
                 android:textColor="@android:color/black"
                 android:text="Files" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="@android:color/darker_gray"
                 android:text="This option will come soon!" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>