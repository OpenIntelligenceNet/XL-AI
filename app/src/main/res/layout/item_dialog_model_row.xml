<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginBottom="8dp"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:layout_marginTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
         android:layout_height="wrap_content"
         android:layout_width="0dp"
         app:hintEnabled="false"
         app:boxStrokeColor="@color/box_stroke_color_selector"
         style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
         android:layout_weight="1"
         android:id="@+id/model_input_layout">

        <com.google.android.material.textfield.TextInputEditText
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="16dp"
             android:textColorHint="#C4C6CA"
             android:textSize="14sp"
             android:textColor="#737270"
             android:textCursorDrawable="@null"
             android:inputType="textNoSuggestions"
             android:id="@+id/et_model_string" />

    </com.google.android.material.textfield.TextInputLayout>

    <ImageView
         android:layout_height="36dp"
         android:layout_width="36dp"
         android:visibility="gone"
         android:src="@drawable/ic_add"
         android:contentDescription="Add fallback model"
         android:background="?attr/selectableItemBackgroundBorderless"
         android:padding="6dp"
         app:tint="#A8C7FA"
         android:layout_marginStart="8dp"
         android:id="@+id/btn_row_action" />

</LinearLayout>