<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="@drawable/bg_dialog_rounded"
     android:padding="24dp"
     android:orientation="vertical">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="12dp"
         android:textSize="22sp"
         android:textColor="#303234"
         android:id="@+id/dialog_title"
         android:text="Add AI model" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="16dp"
         android:textSize="14sp"
         android:textColor="#737270"
         android:lineSpacingMultiplier="1.2"
         android:id="@+id/dialog_message"
         android:text="Enter the exact model string. Add fallback models below in case the primary one is rate-limited." />

    <ScrollView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="24dp"
         android:maxHeight="320dp"
         android:fadeScrollbars="false">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:id="@+id/models_input_container">

        </LinearLayout>

    </ScrollView>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="end"
         android:orientation="horizontal">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:paddingVertical="8dp"
             android:textSize="14sp"
             android:fontFamily="sans-serif-medium"
             android:textColor="#2196F3"
             android:paddingHorizontal="16dp"
             android:focusable="true"
             android:id="@+id/btn_cancel"
             android:text="Cancel" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:clickable="true"
             android:textSize="14sp"
             android:textColor="#2196F3"
             android:layout_marginStart="8dp"
             android:focusable="true"
             android:background="?attr/selectableItemBackground"
             android:paddingVertical="8dp"
             android:fontFamily="sans-serif-medium"
             android:paddingHorizontal="16dp"
             android:id="@+id/btn_set_value"
             android:text="Add AI model" />

    </LinearLayout>

</LinearLayout>