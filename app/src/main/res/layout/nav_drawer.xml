<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/screen_bg"
     android:orientation="vertical"
     android:fitsSystemWindows="true"
     android:id="@+id/nav_view">

    <LinearLayout
         android:layout_height="46dp"
         android:layout_width="match_parent"
         android:layout_marginBottom="12dp"
         android:layout_marginEnd="60dp"
         android:gravity="center_vertical"
         android:background="@drawable/round_search_background"
         android:clickable="true"
         android:orientation="horizontal"
         android:layout_marginTop="12dp"
         android:layout_marginStart="12dp"
         android:focusable="true"
         android:id="@+id/search_bar_container">

        <ImageView
             android:layout_height="24dp"
             android:layout_width="24dp"
             android:src="@drawable/ic_search"
             android:contentDescription="@string/search_icon_description"
             app:tint="@color/text_secondary"
             android:layout_marginStart="15dp"
             android:id="@+id/search_bar_icon" />

        <EditText
             android:layout_height="match_parent"
             android:layout_width="0dp"
             android:layout_marginEnd="8dp"
             android:imeOptions="actionSearch"
             android:clickable="false"
             android:textSize="16sp"
             android:textColor="@color/text_primary"
             android:singleLine="true"
             android:layout_marginStart="14dp"
             android:focusable="false"
             android:background="@null"
             android:hint="@string/search_for_chats"
             android:textAppearance="@style/SafeTextAppearance"
             android:textColorHint="@color/text_secondary"
             android:layout_weight="1"
             android:id="@+id/search_input_edit_text" />

        <ImageView
             android:layout_height="22dp"
             android:layout_width="22dp"
             android:visibility="gone"
             android:layout_marginEnd="14dp"
             android:src="@android:drawable/ic_menu_close_clear_cancel"
             app:tint="@color/text_secondary"
             android:id="@+id/search_clear_btn" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:fillViewport="true"
         android:layout_weight="1"
         android:id="@+id/normal_drawer_scroll_view">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?attr/selectableItemBackground"
                 android:clickable="true"
                 android:padding="16dp"
                 android:orientation="horizontal"
                 android:focusable="true"
                 android:id="@+id/new_chat_button">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_edit"
                     android:contentDescription="@string/new_chat_icon_description"
                     app:tint="@color/text_primary"
                     android:layout_marginStart="11dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginStart="16dp"
                     android:layout_weight="1"
                     android:text="@string/new_chat" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?attr/selectableItemBackground"
                 android:clickable="true"
                 android:padding="16dp"
                 android:orientation="horizontal"
                 android:focusable="true"
                 android:id="@+id/explore_gems_button">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_diamond"
                     android:contentDescription="@string/eva_ai_icon_description"
                     app:tint="@color/text_primary"
                     android:layout_marginStart="11dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginStart="16dp"
                     android:layout_weight="1"
                     android:text="@string/try_eva_ai" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?attr/selectableItemBackground"
                 android:clickable="true"
                 android:padding="16dp"
                 android:orientation="horizontal"
                 android:focusable="true"
                 android:id="@+id/local_llms_button">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_phone_android"
                     android:contentDescription="Local LLMs option"
                     app:tint="@color/text_primary"
                     android:layout_marginStart="11dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textAppearance="@style/SafeTextAppearance"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:layout_marginStart="16dp"
                     android:layout_weight="1"
                     android:text="Local LLMs" />

            </LinearLayout>

            <View
                 android:layout_height="1dp"
                 android:layout_width="match_parent"
                 android:background="@color/divider_different" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:textAppearance="@style/SafeTextAppearance"
                 android:textSize="13sp"
                 android:paddingBottom="4dp"
                 android:textColor="@color/text_secondary"
                 android:paddingStart="27dp"
                 android:text="Recent"
                 android:textStyle="bold"
                 android:paddingTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:paddingBottom="16dp"
                 android:nestedScrollingEnabled="false"
                 android:id="@+id/history_recycler_view"
                 android:overScrollMode="never" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:layout_weight="1"
         android:id="@+id/search_overlay_container">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:orientation="vertical"
             android:paddingHorizontal="20dp"
             android:id="@+id/search_skeleton_layout"
             android:paddingTop="12dp">

            <View
                 android:layout_height="16dp"
                 android:layout_width="180dp"
                 android:layout_marginBottom="8dp"
                 android:background="@color/skeleton_title" />

            <View
                 android:layout_height="12dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="24dp"
                 android:background="@color/skeleton_text" />

            <View
                 android:layout_height="16dp"
                 android:layout_width="220dp"
                 android:layout_marginBottom="8dp"
                 android:background="@color/skeleton_title" />

            <View
                 android:layout_height="12dp"
                 android:layout_width="280dp"
                 android:layout_marginBottom="24dp"
                 android:background="@color/skeleton_text" />

            <View
                 android:layout_height="16dp"
                 android:layout_width="150dp"
                 android:layout_marginBottom="8dp"
                 android:background="@color/skeleton_title" />

            <View
                 android:layout_height="12dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="24dp"
                 android:background="@color/skeleton_text" />

            <View
                 android:layout_height="16dp"
                 android:layout_width="200dp"
                 android:layout_marginBottom="8dp"
                 android:background="@color/skeleton_title" />

            <View
                 android:layout_height="12dp"
                 android:layout_width="250dp"
                 android:background="@color/skeleton_text" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:paddingBottom="24dp"
             android:clipToPadding="false"
             android:id="@+id/search_results_recycler_view" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:visibility="gone"
             android:textAppearance="@style/SafeTextAppearance"
             android:textSize="15sp"
             android:textColor="@color/text_secondary"
             android:id="@+id/search_empty_text"
             android:layout_gravity="center"
             android:text="No matching chats found" />

    </FrameLayout>

</LinearLayout>