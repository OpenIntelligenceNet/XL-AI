<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:orientation="vertical">

    <LinearLayout
         android:layout_height="28dp"
         android:layout_width="wrap_content"
         android:layout_marginBottom="8dp"
         android:background="@drawable/bg_provider_pill"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:layout_marginTop="16dp"
         android:layout_marginStart="12dp"
         android:paddingHorizontal="10dp"
         android:id="@+id/providerPill">

        <ImageView
             android:layout_height="16dp"
             android:layout_width="16dp"
             android:layout_marginEnd="6dp"
             android:contentDescription="Provider Icon"
             android:id="@+id/ivProviderIcon" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="12sp"
             android:textColor="#333333"
             android:id="@+id/tvProviderName"
             android:textStyle="bold"
             android:text="Provider" />

    </LinearLayout>

    <RelativeLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="?attr/selectableItemBackground"
         android:clickable="true"
         android:paddingBottom="8dp"
         android:paddingHorizontal="12dp"
         android:focusable="true">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_toStartOf="@id/btnView"
             android:layout_centerVertical="true"
             android:fontFamily="monospace"
             android:textSize="15sp"
             android:textColor="#333333"
             android:layout_alignParentStart="true"
             android:id="@+id/tvApiKeyPreview"
             android:text="sk-proj-abc123..." />

        <ImageButton
             android:layout_height="24dp"
             android:layout_width="24dp"
             android:layout_marginEnd="16dp"
             android:layout_toStartOf="@id/btnDelete"
             android:contentDescription="View API key"
             android:src="@drawable/ic_eye"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:layout_centerVertical="true"
             app:tint="#888888"
             android:id="@+id/btnView" />

        <ImageButton
             android:layout_height="24dp"
             android:layout_width="24dp"
             android:contentDescription="Delete API key"
             android:src="@drawable/ic_delete"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:layout_centerVertical="true"
             app:tint="#FF4444"
             android:layout_alignParentEnd="true"
             android:id="@+id/btnDelete" />

    </RelativeLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginEnd="12dp"
         android:clickable="true"
         android:padding="4dp"
         android:textSize="13sp"
         android:textColor="#2196F3"
         android:layout_marginStart="12dp"
         android:focusable="true"
         android:layout_marginBottom="12dp"
         android:background="?attr/selectableItemBackground"
         android:id="@+id/tvCustomModel"
         android:text="Add your AI model here"
         android:textStyle="bold" />

    <View
         android:layout_height="1dp"
         android:layout_width="match_parent"
         android:background="#EEEEEE"
         android:layout_marginHorizontal="12dp" />

</LinearLayout>