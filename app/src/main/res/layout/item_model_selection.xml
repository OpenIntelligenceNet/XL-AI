<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:clickable="true"
    android:padding="16dp"
    android:orientation="horizontal"
    android:focusable="true"
    android:id="@+id/modelItemRoot">

    <ImageView
        android:layout_height="32dp"
        android:layout_width="32dp"
        android:src="@drawable/ic_ai_robot"
        android:layout_marginEnd="16dp"
        app:tint="@color/text_primary"
        android:id="@+id/ivModelIcon" />

    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:textSize="16sp"
            android:textAppearance="@style/SafeTextAppearance"
            android:textColor="@color/text_primary"
            android:id="@+id/tvModelName"
            android:textStyle="bold"
            android:text="Model Name" />

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:textSize="13sp"
            android:textAppearance="@style/SafeTextAppearance"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"
            android:id="@+id/tvModelDesc"
            android:text="Model description goes here" />

    </LinearLayout>

    <ImageView
        android:layout_height="24dp"
        android:layout_width="24dp"
        android:visibility="gone"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/brand_blue"
        android:id="@+id/ivCheck" />

</LinearLayout>