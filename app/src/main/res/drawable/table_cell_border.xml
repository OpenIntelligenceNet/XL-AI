<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/table_cell_border.xml
     Draws ONLY the right and bottom border of a cell (the negative offsets push the
     left/top strokes outside the bounds), so neighbouring cells never double up. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-1dp" android:top="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/table_border" />
        </shape>
    </item>
</layer-list>
