<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/table_outer_border.xml
     Draws ONLY the left and top border of the whole table. Together with the
     per-cell right/bottom borders this gives a clean one-line grid. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/table_border" />
        </shape>
    </item>
</layer-list>
